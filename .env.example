# Copie ce fichier en .env et remplis les valeurs. .env n'est JAMAIS commité.

# --- WordPress (API REST, mot de passe d'application) ---
WP_SITE_URL=https://www.decupler.com
WP_USER=ton-utilisateur
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Google Search Console (OAuth, toutes les proprietes d'un coup) ---
# Obtenus une seule fois avec : python3 scripts/gsc_auth.py --client-secret <json>
# Un compte de service demanderait une invitation propriete par propriete ;
# OAuth donne acces a tout ce que le compte Google voit dans l'interface.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# --- DataForSEO (si script ; sinon branché en MCP) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Génération d'images (MCP Gemini / « Nano Banana ») ---
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (optionnel) modèle par défaut du serveur MCP
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# (optionnel) dossier de sortie par défaut des images générées
GEMINI_IMAGE_DIR=./generated-images
