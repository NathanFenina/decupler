# Copie ce fichier en .env et remplis les valeurs. .env n'est JAMAIS commité.

# --- WordPress (API REST, mot de passe d'application) ---
WP_SITE_URL=https://www.decupler.com
WP_USER=ton-utilisateur
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Google Search Console ---
# Voie recommandee : compte de service. Colle ici le CONTENU ENTIER du fichier
# JSON de la cle, sur une seule ligne. Pas d'ecran de consentement, pas de
# testeurs, pas de jeton qui expire. L'adresse client_email doit etre ajoutee
# comme utilisateur dans Search Console, propriete par propriete.
GSC_SA_JSON=
# Voie alternative : OAuth utilisateur (scripts/gsc_auth.py). Ouvre toutes les
# proprietes d'un coup, mais exige un ecran de consentement complet.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# --- DataForSEO (si script ; sinon branché en MCP) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Génération d'images (MCP Gemini / « Nano Banana ») ---
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (optionnel) modèle par défaut du serveur MCP
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# (optionnel) dossier de sortie par défaut des images générées
GEMINI_IMAGE_DIR=./generated-images
