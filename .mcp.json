{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mcpServers": {
    "gemini-images": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts/mcp/gemini_images.py"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}"
      }
    },
    "yoast-seo": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts/mcp/yoast_seo.py"]
    }
  }
}
